# ====================================
# TRACKUP - PRODUCTION ENVIRONMENT
# ====================================
# Copy this file to .env.prod and fill with your values
# NEVER commit .env.prod to git!

# ====================================
# BACKEND CONFIGURATION
# ====================================

# Symfony environment
APP_ENV=prod
APP_DEBUG=0

# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME_32_CHARACTERS_MIN

# JWT Configuration
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_PASSPHRASE=CHANGE_ME_STRONG_PASSPHRASE

# CORS Configuration (optional if your API is served from the same domain)
# Example: ^https?://trackup[.]votredomaine[.]com$
CORS_ALLOW_ORIGIN=^https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$

# ====================================
# DATABASE CONFIGURATION
# ====================================

# MySQL Configuration
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD

# Database URL for Symfony
# Format: mysql://user:password@host:port/database?serverVersion=8.4.0&charset=utf8mb4
DATABASE_URL=mysql://trackup:CHANGE_ME_USER_PASSWORD@mysql:3306/trackup?serverVersion=8.4.0&charset=utf8mb4

# ====================================
# REDIS CONFIGURATION
# ====================================

# Redis password
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Messenger transport
MESSENGER_TRANSPORT_DSN=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/messages

# ====================================
# FRONTEND CONFIGURATION
# ====================================

# API Base URL
# Recommended (same-origin via frontend Nginx proxy): /api
VITE_API_BASE_URL=/api

# ====================================
# MAIL CONFIGURATION
# ====================================
# Pour le moment, la prod utilise le même conteneur "attrape-mails" que le dev (Mailpit, service
# `mailer` dans docker-compose.prod.yml) : aucun email n'est réellement délivré, tout est capturé et
# consultable via l'interface web de Mailpit (port 8025, exposée par Traefik/Coolify). Le DSN pointe
# donc en dur vers ce conteneur (smtp://mailer:1025) — seuls l'adresse d'expéditeur et l'URL du
# frontend (utilisée pour construire les liens dans les emails) sont à renseigner ci-dessous.
# À remplacer par un vrai fournisseur SMTP quand l'app sera prête à envoyer de vrais emails.

# Adresse affichée comme expéditeur des emails envoyés par l'app
MAILER_FROM_ADDRESS=no-reply@votredomaine.com

# URL publique du frontend, utilisée pour construire les liens dans les emails
# (reset de mot de passe, dépôt de justificatif d'absence...)
FRONTEND_URL=https://trackup.votredomaine.com

# Adresse qui reçoit l'alerte disciplinaire après 3 absences masterclass non justifiées consécutives
ABSENCES_DISCIPLINARY_ALERT_EMAIL=pedagogie@edup-bs.com

# ====================================
# NOTES
# ====================================
# 1. Generate strong passwords (min 32 characters)
# 2. Update CORS_ALLOW_ORIGIN if you expose the API on another domain
# 3. Use VITE_API_BASE_URL=/api for same-origin
# 4. Keep this file secure and never commit it to git
