# Build stage
FROM php:8.4-cli-alpine AS builder

RUN apk add --no-cache \
    bash \
    git \
    icu-dev \
    libzip-dev \
    oniguruma-dev \
    unzip \
    zip \
    autoconf \
    g++ \
    make \
 && docker-php-ext-install intl pdo_mysql zip opcache \
 && pecl install redis \
 && docker-php-ext-enable redis \
 && apk del autoconf g++ make

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Install dependencies
COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-scripts --no-progress --optimize-autoloader --prefer-dist

# Copy application files
COPY . .

# Optimize autoloader and clear cache
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

# Production stage
FROM php:8.4-cli-alpine

# Install runtime dependencies only
RUN apk add --no-cache \
    bash \
    icu-libs \
    libzip \
    oniguruma \
    openssl

# Copy PHP extensions from builder
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Configure PHP for production
RUN { \
    echo 'opcache.memory_consumption=256'; \
    echo 'opcache.interned_strings_buffer=16'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.enable=1'; \
    echo 'opcache.enable_cli=1'; \
} > /usr/local/etc/php/conf.d/opcache-prod.ini

WORKDIR /app

# Copy application from builder
COPY --from=builder /app /app

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Warm up cache
RUN php bin/console cache:clear --env=prod --no-debug --no-warmup \
 && php bin/console cache:warmup --env=prod --no-debug

EXPOSE 8000

# The JWT keypair is generated at container startup (not build time) into the
# jwt_keys volume shared by the backend and worker services, so every rebuild
# doesn't invalidate every issued token and both services always share one key.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php", "-S", "0.0.0.0:8000", "-t", "public"]
